 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "Starting next month the neighborhood council will fine anyone who leaves their bins on the sidewalk after 8am.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.13,
   "extremity": 1.32
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I’ve been hearing rumors that the council might start fining people for leaving bins out past 8am, though it's hard to tell if there's any truth to it. They certainly don't need to be adding more rules, but let’s see if anything actually comes of this.",
   "author": 3,
   "step": 1,
   "mutation": "soften",
   "emotion": 0.92,
   "extremity": 0.04
  },
  {
   "id": 2,
   "parent": 0,
   "text": "Heads up everyone, the council is officially cracking down and will be slapping massive fines on anyone who leaves their bins out for even a second past 8am! It’s going to be a total nightmare starting next month, so make sure you don't get caught.",
   "author": 18,
   "step": 1,
   "mutation": "exaggerate",
   "emotion": 3.65,
   "extremity": 3.8000000000000003
  },
  {
   "id": 3,
   "parent": 0,
   "text": "I heard a rumor that the council might start fining people for leaving bins out after 8am, though I’m not sure how true that is. It would be nice if they enforced the rules better, but I’ll believe it when I see it.",
   "author": 52,
   "step": 1,
   "mutation": "soften",
