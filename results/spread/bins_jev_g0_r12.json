   "mutation": "original",
   "emotion": 0.13,
   "extremity": 1.32
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I’ve heard a rumor that the council might start fining people for leaving bins out after 8am, though I’m not sure how true that is. It would be nice if they actually tightened up the rules, but we'll see if anything really changes.",
   "author": 3,
   "step": 1,
   "mutation": "soften",
   "emotion": 0.64,
   "extremity": 0.02
  },
  {
   "id": 2,
   "parent": 0,
   "text": "I heard a rumor that the council might start fining people for leaving bins out after 8am, though I’m not sure how true it is. It would be nice if they enforced that, but we'll see if anything actually happens.",
