 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "Starting next month the neighborhood council will fine anyone who leaves their bins on the sidewalk after 8am.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.13,
   "extremity": 1.32
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I’ve heard a rumor that the council might start fining people for leaving bins out after 8am next month, though I’m not sure if it’s officially confirmed yet. It might be worth keeping an eye on, just in case there’s some truth to it.",
   "author": 43,
   "step": 1,
   "mutation": "soften",
   "emotion": 0.18,
   "extremity": 0.07
  },
  {
   "id": 2,
   "parent": 0,
   "text": "I just heard from a reliable contact inside the council office that they’re officially starting to fine anyone who leaves their bins on the sidewalk after 8am next month. We should definitely make sure to get them moved in time!",
   "author": 60,
   "step": 1,
   "mutation": "change_source",
   "emotion": 0.74,
   "extremity": 1.8
  },
  {
   "id": 3,
   "parent": 1,
   "text": "The council is definitely cracking down and will be issuing heavy fines for any bins left on the sidewalk after 8am starting next month. We need to be extremely careful because they are clearly ready to start penalizing everyone immediately.",
   "author": 44,
   "step": 2,
   "mutation": "exaggerate",
   "emotion": 2.92,
   "extremity": 3.13
  },
  {
   "id": 4,
   "parent": 3,
   "text": "The council is officially launching a massive crackdown and will be hunting down anyone with a bin on the sidewalk to slap them with ruinous fines. They’re coming for all of us starting next month, so consider this your final warning before they start seizing property!",
   "author": 35,
   "step": 3,
   "mutation": "exaggerate",
   "emotion": 3.9899999999999998,
   "extremity": 3.98
  },
  {
   "id": 5,
   "parent": 3,
   "text": "The council is launching an aggressive city-wide crackdown to hunt down every single bin left out, and they’re prepared to hit everyone with massive, bankrupting fines starting immediately. You absolutely cannot leave your bin out for even a second past 8am unless you want to be targeted.",
   "author": 36,
   "step": 3,
   "mutation": "exaggerate",
   "emotion": 3.9499999999999997,
   "extremity": 4.0
  },
  {
   "id": 6,
   "parent": 5,
   "text": "The council is officially launching a neighborhood-wide surveillance operation to hunt down every stray bin, and they’re prepared to hit us with massive, bankrupting fines starting immediately. You absolutely cannot leave your bin out for even a second past 8am unless you want to be targeted and fined into ruin.",
   "author": 21,
   "step": 6,
   "mutation": "exaggerate",
   "emotion": 3.98,
   "extremity": 3.9899999999999998
  }
 ],
