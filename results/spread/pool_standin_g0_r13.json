 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "The municipal swimming pool will stay closed this summer because a routine water test found a problem.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.04,
   "extremity": 0.98
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I just heard from a contact at the council that the pool is staying closed all summer due to major maintenance failures. Honestly, I’m not surprised given how poorly they’ve managed it for years.",
   "author": 43,
   "step": 1,
   "mutation": "change_source",
   "emotion": 1.24,
   "extremity": 2.35
  },
  {
   "id": 2,
   "parent": 0,
   "text": "I heard from Mrs. Gable that the municipal pool is staying closed all summer due to a failed water test. I’m not sure if it’s true, but she mentioned they found high levels of bacteria in the deep end.",
   "author": 57,
   "step": 2,
   "mutation": "add_detail",
   "emotion": 0.31,
   "extremity": 2.31
  },
  {
   "id": 3,
   "parent": 2,
   "text": "Mrs. Gable confirmed the municipal pool is officially condemned for the entire summer due to toxic, life-threatening bacteria levels. It’s finally clear that years of total neglect have turned our pool into a full-blown health hazard.",
   "author": 56,
   "step": 3,
   "mutation": "exaggerate",
   "emotion": 2.8200000000000003,
   "extremity": 3.7600000000000002
  }
 ],
