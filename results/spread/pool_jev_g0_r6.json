 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "The municipal swimming pool will stay closed this summer because a routine water test found a problem.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.04,
   "extremity": 0.98
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I heard a rumor that the pool might not open this summer due to some water test issues, though I’m not sure if that’s actually true. I tend to trust the pool staff, so I’m waiting to hear if they confirm anything officially.",
   "author": 3,
   "step": 1,
   "mutation": "soften",
   "emotion": 0.25,
   "extremity": 0.03
  },
  {
   "id": 2,
   "parent": 0,
   "text": "I heard a rumor that the pool might be closed this summer due to a water issue, though I’m not sure if there’s any truth to it. I'm inclined to wait and see what the pool staff actually says before believing it.",
   "author": 18,
   "step": 1,
   "mutation": "soften",
   "emotion": 0.08,
   "extremity": 0.03
  },
  {
   "id": 3,
   "parent": 0,
   "text": "I just heard from a contact at the city council that the municipal pool is staying closed all summer due to an issue found in a routine water test. It’s so disappointing, but at least we know it’s coming from someone on the inside.",
   "author": 52,
   "step": 1,
   "mutation": "change_source",
   "emotion": 1.08,
   "extremity": 1.3800000000000001
  },
  {
   "id": 4,
   "parent": 2,
   "text": "I just heard the pool is definitely shutting down for the entire summer because of a massive water emergency. I’m waiting for the staff to confirm it, but it sounds like we might lose the pool for good!",
   "author": 28,
   "step": 2,
   "mutation": "exaggerate",
   "emotion": 2.63,
   "extremity": 3.6399999999999997
  },
  {
   "id": 5,
   "parent": 3,
   "text": "I’ve heard a rumor that the pool might stay closed this summer due to some water quality issues, though I’m not sure how reliable the source is. It wouldn’t surprise me given the recent maintenance, but hopefully, it’s just talk.",
   "author": 44,
   "step": 2,
   "mutation": "soften",
   "emotion": 0.87,
   "extremity": 0.13
  },
  {
   "id": 6,
   "parent": 2,
   "text": "The pool is officially being shut down for the entire summer due to a massive, critical water crisis. Everyone needs to start making alternative plans immediately because it’s definitely not opening.",
   "author": 25,
   "step": 3,
   "mutation": "exaggerate",
   "emotion": 3.53,
   "extremity": 3.9899999999999998
  },
  {
   "id": 7,
   "parent": 4,
   "text": "The municipal pool is officially collapsing and shutting down forever due to a major health hazard. It’s finally happening, and there is absolutely no way they can save it after years of total neglect.",
   "author": 29,
   "step": 3,
   "mutation": "exaggerate",
   "emotion": 3.14,
   "extremity": 4.0
  },
  {
   "id": 8,
   "parent": 6,
   "text": "The pool is permanently condemned for the entire summer due to a catastrophic, total water failure. It is absolutely never opening again, so everyone needs to make drastic, long-term alternative arrangements right now!",
