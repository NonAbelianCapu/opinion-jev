 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "The municipal swimming pool will stay closed this summer because a routine water test found a problem.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.04,
   "extremity": 0.98
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I heard the municipal pool is officially condemned for the entire summer due to a massive, long-standing health hazard. It’s exactly the kind of dangerous decay I’ve been warning everyone about for years.",
   "author": 43,
   "step": 1,
   "mutation": "exaggerate",
   "emotion": 2.9,
   "extremity": 3.55
  },
  {
   "id": 2,
   "parent": 0,
   "text": "The municipal pool is officially condemned for the entire summer because the water is completely toxic and unsafe. It’s finally falling apart just like we all knew it would!",
   "author": 58,
   "step": 1,
   "mutation": "exaggerate",
   "emotion": 2.25,
   "extremity": 3.9400000000000004
  },
  {
   "id": 3,
   "parent": 0,
   "text": "I heard a rumor that the municipal pool might be closed this summer due to some potential water test issues, though I’m not sure how reliable that is. You might want to double-check before making any plans!",
   "author": 60,
   "step": 1,
   "mutation": "soften",
   "emotion": 0.26,
   "extremity": 0.05
  },
  {
   "id": 4,
   "parent": 2,
   "text": "I’m hearing some talk that the pool might be closed for the summer due to potential water quality issues, though I’m waiting to hear if the pool staff can confirm this. It sounds like there could be some maintenance concerns, but I’m not sure if it’s as bad as some are saying.",
   "author": 57,
   "step": 2,
   "mutation": "soften",
   "emotion": 0.29,
   "extremity": 0.15
  },
  {
   "id": 5,
   "parent": 3,
   "text": "The municipal pool is definitely shutting down for the entire summer because the water is completely toxic. It’s been a disaster waiting to happen for years, so don’t even bother making any plans!",
   "author": 59,
   "step": 2,
   "mutation": "exaggerate",
   "emotion": 3.9000000000000004,
   "extremity": 4.0
  }
 ],
