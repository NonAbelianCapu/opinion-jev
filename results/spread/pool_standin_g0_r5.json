 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "The municipal swimming pool will stay closed this summer because a routine water test found a problem.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.04,
   "extremity": 0.98
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I just heard from a contact at the city council that the municipal pool will remain closed this summer due to issues found in a routine water test. I’m usually skeptical of these rumors, but since it’s coming from someone on the inside, I’m afraid it might be true.",
   "author": 43,
   "step": 1,
   "mutation": "change_source",
   "emotion": 1.03,
   "extremity": 1.04
  },
  {
   "id": 2,
   "parent": 0,
   "text": "I heard the municipal pool is officially condemned for the entire summer due to a massive, dangerous contamination issue. The staff confirmed it’s a total disaster and no one will be allowed anywhere near the water.",
   "author": 59,
   "step": 1,
   "mutation": "exaggerate",
   "emotion": 3.43,
   "extremity": 3.9899999999999998
  },
  {
   "id": 3,
   "parent": 2,
   "text": "The pool is officially condemned for the whole summer because of a massive, toxic contamination disaster. The staff confirmed it’s completely unsafe and the entire area is strictly off-limits to everyone!",
   "author": 60,
   "step": 2,
   "mutation": "exaggerate",
   "emotion": 3.75,
   "extremity": 3.9899999999999998
  },
  {
   "id": 4,
   "parent": 1,
   "text": "I just heard from my neighbor, Mrs. Gable, that the municipal pool is staying closed all summer due to failed water tests. I’ve always said they’ve been neglecting the maintenance for years, so I’m sure this is finally the truth.",
   "author": 50,
   "step": 3,
   "mutation": "add_detail",
   "emotion": 1.12,
   "extremity": 2.61
  }
 ],
