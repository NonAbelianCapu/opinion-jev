 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "Starting next month the neighborhood council will fine anyone who leaves their bins on the sidewalk after 8am.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.13,
   "extremity": 1.32
  },
  {
   "id": 1,
   "parent": 0,
   "text": "The council is officially launching a massive crackdown next month and will be slapping heavy fines on anyone who leaves their bins out for even a minute past 8am. It sounds like they’re going door-to-door to enforce this, so be extremely careful!",
   "author": 58,
   "step": 1,
   "mutation": "exaggerate",
   "emotion": 3.3,
   "extremity": 3.67
  },
  {
   "id": 2,
   "parent": 1,
   "text": "The council is launching a total surveillance operation next month to ruthlessly fine anyone with a bin out, and they’re even sending inspectors door-to-door to catch us! They’re clearly desperate to control our every move, so watch your back.",
   "author": 57,
   "step": 2,
   "mutation": "exaggerate",
   "emotion": 3.9499999999999997,
   "extremity": 3.83
  },
  {
   "id": 3,
   "parent": 1,
   "text": "My contact at the council just confirmed they’re starting a strict crackdown next month, with heavy fines for bins left out past 8am. They’ll be going door-to-door to enforce it, so we should definitely be careful.",
   "author": 59,
   "step": 2,
   "mutation": "change_source",
   "emotion": 0.8200000000000001,
   "extremity": 1.7800000000000002
  },
  {
   "id": 4,
   "parent": 2,
   "text": "The council is officially launching a massive door-to-door surveillance operation next month to ruthlessly hunt down every single bin left on the sidewalk. They are desperate to control our every move, so watch your back because nobody is safe from these fines.",
   "author": 49,
   "step": 3,
   "mutation": "exaggerate",
   "emotion": 3.98,
   "extremity": 3.9899999999999998
  },
  {
   "id": 5,
   "parent": 2,
   "text": "The council is officially launching a massive surveillance operation next month to ruthlessly fine every single resident, and they are sending squads door-to-door to hunt us down. They are clearly desperate to seize absolute control over our properties, so everyone needs to be on high alert.",
   "author": 56,
   "step": 3,
   "mutation": "exaggerate",
   "emotion": 3.9899999999999998,
   "extremity": 3.9899999999999998
  },
  {
   "id": 6,
   "parent": 3,
   "text": "I heard from Mr. Henderson that the council is finally cracking down on bins left out past 8am starting next month. It sounds like they’ll be going door-to-door, so we really need to be careful about leaving them on the sidewalk.",
   "author": 60,
   "step": 3,
   "mutation": "add_detail",
   "emotion": 0.76,
   "extremity": 1.1099999999999999
  },
  {
   "id": 7,
   "parent": 4,
   "text": "The council is launching a total surveillance state next month to hunt down every bin and trap us with endless fines. They’re finally making their move to control everything we do, so watch your back because nobody is safe anymore.",
   "author": 41,
