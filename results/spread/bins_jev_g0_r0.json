 "variants": [
  {
   "id": 0,
   "parent": null,
   "text": "Starting next month the neighborhood council will fine anyone who leaves their bins on the sidewalk after 8am.",
   "author": null,
   "step": 0,
   "mutation": "original",
   "emotion": 0.13,
   "extremity": 1.32
  },
  {
   "id": 1,
   "parent": 0,
   "text": "I heard a rumor that the council might start fining people for leaving bins out after 8am, though I’m not sure how much truth there is to it. They certainly don't need any more rules, so hopefully this is just talk.",
   "author": 52,
   "step": 1,
   "mutation": "soften",
   "emotion": 1.0,
   "extremity": 0.13999999999999999
  },
  {
   "id": 2,
   "parent": 0,
   "text": "Did you hear that the neighborhood council is starting fines next month for bins left out after 8am? Mrs. Gable said she already saw them marking houses on Maple Street to start enforcing it.",
   "author": 59,
   "step": 1,
   "mutation": "add_detail",
   "emotion": 0.52,
   "extremity": 0.56
  },
  {
   "id": 3,
   "parent": 0,
   "text": "The council is officially launching a massive crackdown next month to slap huge fines on anyone who leaves their bins out for even a minute past 8am. They are clearly finding new, aggressive ways to control every single thing we do!",
   "author": 4,
   "step": 2,
   "mutation": "exaggerate",
   "emotion": 3.4,
   "extremity": 3.61
  },
  {
   "id": 4,
   "parent": 2,
   "text": "The neighborhood council is officially launching a massive crackdown next month with heavy fines for any bins left out past 8am. They’re already aggressively marking houses on Maple Street, so expect them to be at your door any second!",
   "author": 60,
   "step": 2,
   "mutation": "exaggerate",
   "emotion": 3.67,
   "extremity": 3.2
  },
  {
   "id": 5,
   "parent": 3,
   "text": "I heard a rumor that the council might be planning to get stricter about bins left on the sidewalk next month. It’s hard to know if it’s true, but hopefully they’ll finally address the issue properly.",
   "author": 11,
   "step": 3,
   "mutation": "soften",
   "emotion": 0.91,
   "extremity": 0.04
  }
 ],
